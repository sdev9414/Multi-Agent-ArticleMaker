# FastAPI AI service environment variables
# Copy to .env and fill in real values. Never commit .env.

# Server
# NOTE: 8000 is commonly taken by other local services — this project uses 8010.
PORT=8010
ENV=development

# ─── Model / provider selection ────────────────────────────────────────────
# The ONE place to switch providers. See ai-service/services/llm/config.py.
#   LLM_PROVIDER: openai | gemini | mock
# If the chosen provider has no API key, the service auto-falls back to "mock"
# so it always runs locally.
LLM_PROVIDER=openai

# Per-provider model + key. Override the model to switch within a provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

GEMINI_API_KEY=
# gemini-2.5-flash has a generous free-tier quota; 2.5-pro is far more limited.
GEMINI_MODEL=gemini-2.5-flash

# Search
TAVILY_API_KEY=

# Observability (optional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Database (for AgentRuns / Evaluations if written directly)
MYSQL_URL=mysql://user:password@localhost:3306/newsroom
