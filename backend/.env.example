# Express backend environment variables
# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=4000
NODE_ENV=development

# MySQL connection string
MYSQL_URL=mysql://user:password@localhost:3306/newsroom

# Auth
JWT_SECRET=change-me

# Downstream AI service
FASTAPI_URL=http://localhost:8010

# Max time (ms) to wait for a full AI workflow run (rides out rate-limit cool-offs).
AI_TIMEOUT_MS=300000
